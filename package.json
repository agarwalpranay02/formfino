    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "tesseract.js": "6.0.1",
    "fflate": "0.8.3",
    "papaparse": "5.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
